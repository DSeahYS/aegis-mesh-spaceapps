# AEGIS-MESH Environment Configuration
# Copy this file to .env and fill in values as needed.

# Backend (FastAPI / PolarFire Edge Simulation)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PYTHONUNBUFFERED=1
HARDWARE_PLATFORM=Microchip_PolarFire_MPFS250T
SWAP_ENVELOPE=0.5_CPU_256MB_RAM

# Frontend (Vite dev server)
VITE_API_BASE_URL=http://localhost:8000

# Celestrak TLE endpoint (public, no key required)
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php